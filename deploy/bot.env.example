# Copy to /etc/sglang-npu-bot/bot.env, owned by root with mode 0600.
# A fine-grained PAT belonging to sglang-ci-npu-bot:
# grant ONLY Issues: Read and write on sglang-ci-npu-bot/sglang-ci-npu-bot.
# Avoid spaces/quotes around values in this EnvironmentFile.
GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_PAT
TARGET_REPOSITORY=sglang-ci-npu-bot/sglang-ci-npu-bot
SOURCE_REPOSITORY=sgl-project/sglang
MAX_RUNS_PER_WORKFLOW=320
MAX_JOB_LOGS=60
RAW_LOG_RETENTION_DAYS=2
RAW_LOG_DISK_BUDGET_MB=2048
# v22: 1-3 validated main incidents at most; PR-only never creates by default.
MAX_NEW_CLUSTER_ISSUES=3
MAX_PUBLISHED_MAIN_ISSUES=3
CREATE_PR_ONLY_ISSUES=0

# OPTIONAL: only for supported, permitted GLM/Coding Plan integrations.
# If unset, deterministic analysis still publishes the report.
# GLM_API_KEY=REPLACE_WITH_GLM_KEY
# GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-5.3-flash
# GLM_ANALYSIS_MODE=auto  # main-first deep investigation, triage-only if no qualified incidents
# GLM_MAX_INVESTIGATIONS=2  # qualified main / exceptionally replicated cross-PR incidents
# GLM_MAX_PR_CONTEXT=6
# GLM_REASONING_EFFORT=high  # higher reasoning output budget; billing caps remain enforced
# GLM_MAX_OUTPUT_TOKENS=24000
# GLM_TRIAGE_MAX_TOKENS=10000
# GLM_CLUSTER_MAX_TOKENS=16000
# GLM_SYNTHESIS_MAX_TOKENS=20000
# GLM_EMPTY_RETRIES=0  # prevents automatic additional paid requests
# GLM_API_TIMEOUT_SECONDS=420
# GLM_MANUAL_REASONING_EFFORT=high
# GLM_MANUAL_MAX_INVESTIGATIONS=1
# GLM_MANUAL_MAX_OUTPUT_TOKENS=16000
# GLM_MANUAL_CLUSTER_MAX_TOKENS=12000
# GLM_MANUAL_SYNTHESIS_MAX_TOKENS=12000
# Local budget estimates use CONFIGURED prices; CHECK BigModel billing for actual charges.
# GLM_BUDGET_ENABLED=1
# GLM_DAILY_BUDGET_CNY=1.00
# GLM_PER_REQUEST_BUDGET_CNY=0.50
# GLM_MAX_DAILY_API_REQUESTS=4
# GLM_INPUT_CNY_PER_M=0.80  # example ONLY; replace with your actual contracted tariff
# GLM_OUTPUT_CNY_PER_M=2.80  # example ONLY; includes reasoning in output tokens
# GLM_BUDGET_LEDGER=reports/glm-budget.sqlite3

# OPTIONAL: separate source read token; leaving absent uses GITHUB_TOKEN.
# SOURCE_GITHUB_TOKEN=READ_ONLY_TOKEN

# Optional Git proxy for future public SGLang source downloads ONLY:
# GitHub REST API reads and Issues publication use direct api.github.com.
# Tested on this openEuler host: /https://api.github.com/... returned HTTP 403.
# GITHUB_GIT_PROXY=https://gh-proxy.test.osinfra.cn/
# Older v4 GITHUB_PUBLIC_READ_PROXY is deprecated and ignored.
# All GitHub API token-bearing requests always go directly to api.github.com.

# v15 GitHub issue output: human-first summary, full GLM stored only locally.
REPORT_FORMAT=research
REPORT_INCLUDE_DEEP_DETAILS=0
REPORT_UPDATE_CLUSTER_DETAILS=1
# REPORT_FORMAT=verbose          # opt-in to v14 long daily Issue
# REPORT_INCLUDE_DEEP_DETAILS=1  # collapsible long GLM appendix inside daily Issue

# v16: incident classification uses confirmed run event/branch/provenance.
# GitHub Issue taxonomy labels: main, not-merged, unconfirmed, flaky, infrastructure.
# IMPORTANT: a PR with base=main is not a main-run failure.

# v17: English-language issue publication and bounded verified PR leads
REPORT_LANGUAGE=en
PR_SEARCH_ENABLED=1
PR_SEARCH_MAX_PER_CLUSTER=3

# v21.0.2: Archive earlier daily REPORT Issues after successful publication.
# Cluster INCIDENT Issues remain open until separately verified resolved.
ARCHIVE_PREVIOUS_DAILY_ISSUES=1
# Suggested optional deep-investigation profile (requires a calibrated CNY budget):
# GLM_ANALYSIS_MODE=investigate
# GLM_MAX_INVESTIGATIONS=2
# GLM_REASONING_EFFORT=high
# GLM_MAX_OUTPUT_TOKENS=24000
# GLM_CLUSTER_MAX_TOKENS=16000
# GLM_SYNTHESIS_MAX_TOKENS=20000

# v22.2: completed stages are cached for exact-evidence retries by default.
# Snapshot, prompt version, endpoint, model and token/reasoning settings key each entry.
# GLM_STAGE_CACHE_DIR=reports/analysis/stage-cache
# Set an empty value to disable caching. Cached stages make no new API request.
# `--allow-partial` is an explicit CLI option for manual issue refresh.

# v21.0.3 deterministic verified testcase lifecycle (does NOT call GLM).
# Closing requires exact machine-readable PASS/FAIL markers in SGLang CI logs.
INCIDENT_VERIFY_PASSES=1
INCIDENT_AUTO_CLOSE=1
INCIDENT_AUTO_CLOSE_PR=0
INCIDENT_MAX_PASS_LOGS=24
# See docs/TESTCASE_PASS_VERIFICATION.md for CI instrumentation.

# v22 migration: deployment preserves existing bot.env (including old low settings).
# Explicit opt-in: sudo bash /opt/npu-diffusion-ci-kit/deploy/apply-research-profile.sh --apply
# This changes only LLM token limits, routing and report/issue policy,
# NEVER monetary budget thresholds or tariff estimates.

# P1/P2 final profile: bounded GitHub PR intelligence and failure log coverage.
PR_SEARCH_MAX_API_CALLS=38
