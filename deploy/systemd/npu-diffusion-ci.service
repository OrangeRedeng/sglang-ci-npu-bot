[Unit]
Description=Ascend NPU Diffusion CI daily analysis to GitHub Issues
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sglang-ci
Group=sglang-ci
WorkingDirectory=/home/sglang-npu-bot
EnvironmentFile=/etc/sglang-npu-bot/bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/home/sglang-npu-bot
ExecStartPre=/usr/bin/python3 /home/sglang-npu-bot/scripts/npu_network_check.py --sample-jobs --attempts 3
ExecStart=/usr/bin/python3 /home/sglang-npu-bot/scripts/npu_diffusion_ci_report.py --lookback-hours 24 --skip-if-published-today
TimeoutStartSec=90min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/sglang-npu-bot

[Install]
WantedBy=multi-user.target
