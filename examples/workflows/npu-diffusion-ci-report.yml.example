# EXAMPLE ONLY: not installed in .github/workflows to prevent accidental publisher deployment.
# Requires NPU_CI_ISSUES_TOKEN with Issues:write in target report repo.
name: NPU Diffusion CI Daily Analysis (fallback)

on:
  # UTC 11:45 = Europe/Moscow 14:45, after the openEuler primary at 13:15 MSK.
  schedule:
    - cron: '45 11 * * *'
  workflow_dispatch:
    inputs:
      lookback_hours:
        description: 'How many hours of SGLang CI to inspect'
        type: choice
        options: ['24', '48', '168']
        default: '24'
        required: false
      dry_run:
        description: 'Generate files without creating/updating Issues'
        type: boolean
        default: true
        required: false
      force_refresh:
        description: 'Update report even if already published today (manual only)'
        type: boolean
        default: false
        required: false

permissions:
  contents: read
  actions: read
  issues: write

concurrency:
  group: npu-diffusion-ci-report
  cancel-in-progress: false

jobs:
  fallback-report:
    # No NPU or access to the openEuler server is required.
    runs-on: ubuntu-latest
    timeout-minutes: 55
    env:
      GITHUB_TOKEN: ${{ secrets.NPU_CI_ISSUES_TOKEN }}
      SOURCE_REPOSITORY: sgl-project/sglang
      TARGET_REPOSITORY: sglang-ci-npu-bot/sglang-ci-npu-bot
      MAX_RUNS_PER_WORKFLOW: '320'
      MAX_JOB_LOGS: '20'
      MAX_NEW_CLUSTER_ISSUES: '12'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.12'
      - name: Collect backup snapshot, no GLM charges
        shell: bash
        env:
          LOOKBACK_HOURS: ${{ github.event.inputs.lookback_hours || '24' }}
          DRY_RUN: ${{ github.event.inputs.dry_run || 'false' }}
          FORCE_REFRESH: ${{ github.event.inputs.force_refresh || 'false' }}
        run: |
          args=(--lookback-hours "$LOOKBACK_HOURS" --no-glm)
          if [[ "$DRY_RUN" == true ]]; then args+=(--dry-run); fi
          if [[ "$FORCE_REFRESH" != true ]]; then args+=(--skip-if-published-today); fi
          python scripts/npu_diffusion_ci_report.py "${args[@]}"
      - name: Upload Markdown + JSON
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: npu-diffusion-ci-fallback-${{ github.run_id }}-${{ github.run_attempt }}
          # Raw GitHub logs may contain secrets; upload ONLY redacted derivatives.
          path: |
            reports/*.md
            reports/*.json
          retention-days: 90
          if-no-files-found: ignore
